{
  "$schema": "https://json.schemastore.org/package",
  "name": "@manafishrov/ui-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:lib && bun run build:docs",
    "build:docs": "cd packages/docs && bunx vite build",
    "build:lib": "cd packages/lib && bunx vite build",
    "dev": "cd packages/docs && bunx vite",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "preview": "cd packages/docs && bunx vite preview",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.87",
    "@inlang/paraglide-js": "2.25.1",
    "@types/bun": "1.4.2",
    "@typescript/typescript6": "6.0.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "typescript-language-server": "5.3.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-icons": "23.0.1",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.13"
  }
}

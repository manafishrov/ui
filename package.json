{
  "$schema": "https://json.schemastore.org/package",
  "name": "@manafishrov/ui-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:lib && bun run build:docs",
    "build:docs": "cd packages/docs && bunx vite build",
    "build:lib": "cd packages/lib && bunx vite build",
    "dev": "cd packages/docs && bunx vite",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "preview": "cd packages/docs && bunx vite preview"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.70",
    "@inlang/paraglide-js": "2.15.3",
    "@types/bun": "1.3.13",
    "lefthook": "2.1.6",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "typescript": "6.0.3",
    "typescript-language-server": "5.1.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "vite": "8.0.11",
    "vite-plugin-solid": "2.11.12"
  }
}

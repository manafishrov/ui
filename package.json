{
  "$schema": "https://json.schemastore.org/package",
  "name": "manafish-ui-monorepo",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "cd packages/docs && bunx vite",
    "build": "bun run build:lib && bun run build:docs",
    "build:lib": "cd packages/lib && bunx vite build",
    "build:docs": "cd packages/docs && bunx vite build",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "publish": "bun run build:lib && cd packages/lib && npm publish"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "lefthook": "2.1.1",
    "oxfmt": "0.24.0",
    "oxlint": "1.39.0",
    "oxlint-tsgolint": "0.14.2",
    "typescript": "5.9.3",
    "vite": "6.1.1",
    "vite-plugin-solid": "2.11.10"
  }
}

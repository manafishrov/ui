{
  "$schema": "https://json.schemastore.org/package",
  "name": "@manafishrov/ui-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:lib && bun run build:docs",
    "build:docs": "cd packages/docs && bunx vite build",
    "build:lib": "cd packages/lib && bunx vite build",
    "dev": "cd packages/docs && bunx vite",
    "fmt": "oxfmt --write packages/**/*.ts packages/**/*.tsx",
    "fmt:check": "oxfmt --check packages/**/*.ts packages/**/*.tsx",
    "lint": "oxlint --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint --type-aware --type-check --deny-warnings --fix",
    "prepare": "lefthook install",
    "preview": "cd packages/docs && bunx vite preview"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.59",
    "@inlang/paraglide-js": "2.12.0",
    "@types/bun": "1.3.9",
    "lefthook": "2.1.2",
    "oxfmt": "0.36.0",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "0.15.0",
    "typescript": "5.9.3",
    "typescript-language-server": "5.1.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.10"
  }
}

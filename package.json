{
  "$schema": "https://json.schemastore.org/package",
  "name": "@manafishrov/ui-workspace",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:lib && bun run build:docs",
    "build:docs": "cd packages/docs && bunx vite build",
    "build:lib": "cd packages/lib && bunx vite build",
    "dev": "cd packages/docs && bunx vite",
    "fmt": "oxfmt --write packages/**/*.ts packages/**/*.tsx",
    "fmt:check": "oxfmt --check packages/**/*.ts packages/**/*.tsx",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "prepare": "lefthook install",
    "publish": "bun run build:lib && cd packages/lib && npm publish"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.12.0",
    "@types/bun": "1.3.9",
    "lefthook": "2.1.1",
    "oxfmt": "0.35.0",
    "oxlint": "1.50.0",
    "oxlint-tsgolint": "0.15.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.10"
  }
}
